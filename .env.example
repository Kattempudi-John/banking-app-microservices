# Template for local secrets. Copy to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored; this file is not. Never put a real credential in THIS file - it is tracked,
# and anything committed to git stays in the history even after it is deleted.
#
# Nothing here is required to run the project. Every service starts with no credentials at all:
# the notification providers default to "logging", which writes messages to the service log instead
# of sending them. Fill these in only when you want real delivery.

# ---------------------------------------------------------------------------
# SMS - 2FA codes (notification-service)
# ---------------------------------------------------------------------------
# logging (default, no account needed) | textbelt (free tier, no signup) | twilio
SMS_PROVIDER=logging

# From the Twilio console. The auth token is a password - treat it like one.
# Rotate it immediately in the console if it is ever pasted somewhere shared.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A number Twilio has issued to your account, in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Email - balance summaries and transaction alerts (notification-service)
# ---------------------------------------------------------------------------
# SendGrid is Twilio's email product but a SEPARATE API with its own key - the Twilio
# credentials above do not work here.
# logging (default, no account needed) | sendgrid
EMAIL_PROVIDER=logging

SENDGRID_API_KEY=
# Must be an address verified as a sender in SendGrid, or every send is rejected
SENDGRID_FROM_EMAIL=

# Template for local secrets. Copy to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored; this file is not. Never put a real credential in THIS file - it is tracked,
# and anything committed to git stays in the history even after it is deleted.
#
# Nothing here is required to run the project. Every service starts with no credentials at all:
# the notification providers default to "logging", which writes messages to the service log instead
# of sending them - including 2FA codes, so you can log in locally with nothing configured. Fill
# these in only when you want real delivery.

# ---------------------------------------------------------------------------
# Email - 2FA codes, balance summaries and transaction alerts (notification-service)
# ---------------------------------------------------------------------------
# This is the section that matters. 2FA moved from SMS to email, so email now carries every
# notification the app sends, and it is the only provider a real deployment has to configure.
#
# Two real options, two different products:
#
#   twilio   - Twilio Email. Reuses TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN below, so there is no extra
#              key to manage. Requires the sender domain to be authenticated via DNS in the console.
#   sendgrid - the classic SendGrid v3 API, a SEPARATE API with its own key. Its single-sender
#              verification needs no DNS access, which is why this is the one prod runs on.
#
# logging (default, no account needed) | twilio | sendgrid
EMAIL_PROVIDER=logging

# For EMAIL_PROVIDER=sendgrid. The API key is a credential that can send mail billed to your
# account - treat it like a password and revoke it in the SendGrid console if it ever leaks.
SENDGRID_API_KEY=
# Must be an address verified as a sender in SendGrid, or every send is rejected
SENDGRID_FROM_EMAIL=

# For EMAIL_PROVIDER=twilio. Must be a sender identity verified in the Twilio console; the SID and
# auth token come from the SMS section below.
TWILIO_FROM_EMAIL=
# Display name on the From header. Optional - defaults to "Banking Alerts".
TWILIO_FROM_NAME=

# ---------------------------------------------------------------------------
# SMS - dormant (notification-service)
# ---------------------------------------------------------------------------
# Nothing sends an SMS any more: 2FA was the only feature that did and it is email now. The Twilio
# and Textbelt clients are still in the codebase for a possible future channel, so these variables
# still work - they are just unused, and no environment including prod needs them set.
#
# If you do switch SMS_PROVIDER to twilio, set all three TWILIO_* values with it. The client checks
# them at startup and refuses to boot on a blank one, so "twilio" with missing credentials takes the
# whole service down rather than degrading quietly.
#
# logging (default, no account needed) | textbelt (free tier, no signup) | twilio
SMS_PROVIDER=logging

# From the Twilio console. The auth token is a password - treat it like one.
# Rotate it immediately in the console if it is ever pasted somewhere shared.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A number Twilio has issued to your account, in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=

